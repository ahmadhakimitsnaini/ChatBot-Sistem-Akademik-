# ==============================================================================
# TEMPLATE KONFIGURASI LINGKUNGAN (.env.example)
# ==============================================================================
# Cara Penggunaan di Lokal:
# 1. Salin file ini menjadi file baru bernama `.env` (perintah: cp .env.example .env)
# 2. Isi variabel di bawah ini dengan API Key asli Anda.
# 3. JANGAN PERNAH mengunggah file `.env` asli ke GitHub!
# ==============================================================================

# Konfigurasi Utama: MoonMath Zro API / DeepSeek (OpenAI-Compatible)
# Endpoint Zro: https://zro.moonmath.ai/v1 (Model: deepseek-v4.1-flash)
# Endpoint DeepSeek resmi: https://api.deepseek.com (Model: deepseek-chat)
DEEPSEEK_API_KEY="masukkan_api_key_anda_di_sini"
DEEPSEEK_BASE_URL="https://zro.moonmath.ai/v1"
DEEPSEEK_MODEL="deepseek-v4.1-flash"

# Konfigurasi Parameter Mini-RAG
RAG_THRESHOLD="0.18"
