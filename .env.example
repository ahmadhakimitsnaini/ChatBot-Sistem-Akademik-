# ==============================================================================
# TEMPLATE KONFIGURASI LINGKUNGAN (.env.example)
# ==============================================================================
# Cara Penggunaan di Lokal:
# 1. Salin file ini menjadi file baru bernama `.env` (perintah: cp .env.example .env)
# 2. Isi variabel di bawah ini dengan API Key asli Anda.
# 3. JANGAN PERNAH mengunggah file `.env` asli ke GitHub!
# ==============================================================================

# Opsi 1 (Utama): Google Gemini API Key
# Dapatkan secara gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="masukkan_api_key_gemini_anda_di_sini"

# Opsi 2 (Alternatif): Groq Cloud API Key
# Dapatkan secara gratis di: https://console.groq.com/keys
GROQ_API_KEY=""

# Konfigurasi Opsional Model & Parameter RAG
LLM_PROVIDER="gemini"
GEMINI_MODEL="gemini-2.5-flash"
RAG_THRESHOLD="0.18"
